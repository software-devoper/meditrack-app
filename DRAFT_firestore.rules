rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Helper to get current user's profile from Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isEmailVerified() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin';
    }

    function isStaff() {
      return isEmailVerified() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserData().role == 'staff' || getUserData().role == 'admin');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validations
    function isValidUser(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 20 &&
             data.role in ['admin', 'staff'] &&
             data.isActive is bool &&
             data.internalAuthEmail is string;
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.genericName is string &&
             data.stockQty is number && data.stockQty >= 0 &&
             data.purchasePrice is number && data.purchasePrice >= 0 &&
             data.rate is number && data.rate >= 0;
    }

    function isValidSale(data) {
      return data.invoiceNo is string && data.invoiceNo.size() > 0 &&
             data.items is list && data.items.size() > 0 &&
             data.grandTotal is number && data.grandTotal >= 0 &&
             data.status in ['completed', 'returned'];
    }

    function isValidCustomer(data) {
      return data.name is string && data.name.size() > 0 &&
             data.phone is string &&
             data.type in ['sale', 'purchase'];
    }

    // 4. Collection Matches
    match /users/{userId} {
      allow get: if isStaff();
      allow list: if isAdmin();
      // Only admins can create users
      allow create: if isAdmin() && isValidUser(incoming());
      // Users can update their own non-sensitive fields
      allow update: if (isAdmin() || (isSignedIn() && request.auth.uid == userId)) && 
                    isValidUser(incoming()) &&
                    (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'contactEmail', 'username']));
    }

    match /products/{productId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && isValidCustomer(incoming());
      allow delete: if isAdmin();
    }

    match /doctors/{doctorId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidSale(incoming());
      allow update: if isAdmin(); // Only admins can modify past sales
      allow delete: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /stockLedger/{ledgerId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false; // Ledger should be immutable
    }

    match /metadata/{metaId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
  }
}
